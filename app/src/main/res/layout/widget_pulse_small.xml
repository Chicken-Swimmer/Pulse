<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widgetBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.18"
        android:text="PULSE"
        android:textColor="#7DD3C7"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widgetPercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-thin"
        android:text="—"
        android:textColor="#F0FDFA"
        android:textSize="32sp" />

    <TextView
        android:id="@+id/widgetSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 ↑   0 ↓"
        android:textColor="#7DD3C7"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widgetChecked"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#6B9E98"
        android:textSize="10sp"
        android:text="" />

    <TextView android:id="@+id/widgetUp" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />
    <TextView android:id="@+id/widgetDown" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />
</LinearLayout>
