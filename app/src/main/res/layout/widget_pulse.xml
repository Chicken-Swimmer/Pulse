<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widgetBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.2"
            android:text="PULSE"
            android:textColor="#7DD3C7"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widgetPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-thin"
            android:text="—"
            android:textColor="#F0FDFA"
            android:textSize="36sp" />

        <TextView
            android:id="@+id/widgetSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Overall health"
            android:textColor="#7DD3C7"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widgetChecked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#6B9E98"
            android:textSize="11sp"
            android:text="" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView android:id="@+id/widgetUp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#2DD4BF" android:textSize="14sp" android:text="Up: 0" />
        <TextView android:id="@+id/widgetDown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#F87171" android:textSize="14sp" android:text="Down: 0" />
        <TextView android:id="@+id/widgetPaused" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#6B9E98" android:textSize="14sp" android:text="Paused: 0" />
    </LinearLayout>
</LinearLayout>
