<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="#061A18">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#061A18">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="128dp"
            android:scaleType="fitXY"
            android:importantForAccessibility="no"
            android:src="@drawable/bg_settings_header" />

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@android:color/transparent"
            android:paddingEnd="8dp"
            app:title="@string/settings"
            app:subtitle="Version"
            app:titleTextColor="#FFFFFFFF"
            app:subtitleTextColor="#FFFFFFFF"
            app:navigationIconTint="#FFFFFFFF"
            app:titleTextAppearance="@style/SettingsHeaderTitle"
            app:subtitleTextAppearance="@style/SettingsHeaderSub" />

        <TextView
            android:id="@+id/txtVersionFooter"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView style="@style/SettingsSection" android:text="@string/settings_section_look" />

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">

                    <LinearLayout android:id="@+id/rowQuietHours" style="@style/SettingsRow">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_moon" android:contentDescription="@null" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsTitle" android:text="@string/quiet_hours" />
                            <TextView android:id="@+id/txtQuietHoursDetails" style="@style/SettingsSub" tools:text="22:00 – 07:00" />
                        </LinearLayout>
                        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchQuietHours" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                    <View style="@style/SettingsDivider" />
                    <LinearLayout android:id="@+id/rowNotifySound" style="@style/SettingsRow">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_bell" android:contentDescription="@null" />
                        <TextView style="@style/SettingsTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/notify_sound" />
                        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchNotifySound" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                    <View style="@style/SettingsDivider" />
                    <LinearLayout android:id="@+id/rowNotifyVibrate" style="@style/SettingsRow">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_vibrate" android:contentDescription="@null" />
                        <TextView style="@style/SettingsTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/notify_vibrate" />
                        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchNotifyVibrate" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                    <View style="@style/SettingsDivider" />
                    <LinearLayout android:id="@+id/btnTestNotification" style="@style/SettingsRow">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_bell" android:contentDescription="@null" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsTitle" android:text="@string/test_notification" />
                            <TextView style="@style/SettingsSub" android:text="@string/test_notification_sub" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/SettingsSection" android:text="@string/settings_section_monitoring" android:paddingTop="20dp" />

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">

                    <LinearLayout android:id="@+id/btnMonitorInterval" style="@style/SettingsRow">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_refresh" android:contentDescription="@null" />
                        <TextView style="@style/SettingsTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/monitoring_interval" />
                        <TextView android:id="@+id/txtIntervalDetails" style="@style/SettingsValue" tools:text="15 min" />
                    </LinearLayout>
                    <View style="@style/SettingsDivider" />
                    <LinearLayout android:id="@+id/btnMonitorStatusCodes" style="@style/SettingsRow">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_code" android:contentDescription="@null" />
                        <TextView style="@style/SettingsTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/monitoring_status_codes" />
                        <TextView android:id="@+id/txtStatusCodesDetails" style="@style/SettingsValue" tools:text="2xx" />
                    </LinearLayout>
                    <View style="@style/SettingsDivider" />
                    <LinearLayout android:id="@+id/btnRequestTimeout" style="@style/SettingsRow">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_hourglass" android:contentDescription="@null" />
                        <TextView style="@style/SettingsTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/request_timeout" />
                        <TextView android:id="@+id/txtTimeoutDetails" style="@style/SettingsValue" tools:text="10 s" />
                    </LinearLayout>
                    <View style="@style/SettingsDivider" />
                    <LinearLayout android:id="@+id/btnSortMode" style="@style/SettingsRow">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_sort" android:contentDescription="@null" />
                        <TextView style="@style/SettingsTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/sort_mode" />
                        <TextView android:id="@+id/txtSortDetails" style="@style/SettingsValue" tools:text="Down first" />
                    </LinearLayout>
                    <View style="@style/SettingsDivider" />
                    <LinearLayout android:id="@+id/btnNotifyRecovery" style="@style/SettingsRow">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_play" android:contentDescription="@null" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsTitle" android:text="@string/notify_on_recovery" />
                            <TextView android:id="@+id/txtNotifyRecoveryDetails" style="@style/SettingsSub" />
                        </LinearLayout>
                    </LinearLayout>
                    <View style="@style/SettingsDivider" />
                    <LinearLayout android:id="@+id/btnMorningTime" style="@style/SettingsRow">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_moon" android:contentDescription="@null" />
                        <TextView style="@style/SettingsTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/morning_time" />
                        <TextView android:id="@+id/txtMorningTime" style="@style/SettingsValue" tools:text="07:00" />
                    </LinearLayout>
                    <View android:id="@+id/dividerEnableAutoStart" style="@style/SettingsDivider" />
                    <LinearLayout android:id="@+id/layoutEnableAutoStart" style="@style/SettingsRow" android:orientation="vertical">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEnableAutoStart"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/enable_auto_start" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/SettingsSection" android:text="@string/settings_section_data" android:paddingTop="20dp" />

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:id="@+id/btnExportData" style="@style/SettingsRow">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_export" android:contentDescription="@null" />
                        <TextView style="@style/SettingsTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/export_data" />
                        <TextView style="@style/SettingsChevron" android:text="›" />
                    </LinearLayout>
                    <View style="@style/SettingsDivider" />
                    <LinearLayout android:id="@+id/btnImportData" style="@style/SettingsRow">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_import" android:contentDescription="@null" />
                        <TextView style="@style/SettingsTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/import_data" />
                        <TextView style="@style/SettingsChevron" android:text="›" />
                    </LinearLayout>
                    <View style="@style/SettingsDivider" />
                    <LinearLayout android:id="@+id/btnShareData" style="@style/SettingsRow">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_share" android:contentDescription="@null" />
                        <TextView style="@style/SettingsTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/share_data" />
                        <TextView style="@style/SettingsChevron" android:text="›" />
                    </LinearLayout>
                    <View style="@style/SettingsDivider" />
                    <LinearLayout android:id="@+id/btnClearHistory" style="@style/SettingsRow">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_delete" android:contentDescription="@null" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsTitle" android:text="@string/clear_history" />
                            <TextView style="@style/SettingsSub" android:text="@string/clear_history_sub" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
